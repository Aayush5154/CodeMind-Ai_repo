# ─── Runtime ───────────────────────────────────────────────────────────────
# "production" enables strict env validation, hides error details, and enforces
# the CORS allowlist. Leave unset (or "development") for local work.
NODE_ENV=development
PORT=5000

# ─── MongoDB (Atlas) ───────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/codemind?retryWrites=true&w=majority

# ─── Qdrant Vector Database ────────────────────────────────────────────────
QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_API_KEY=

# ─── LLM ───────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash

# ─── Embeddings ────────────────────────────────────────────────────────────
# EMBEDDING_DIMENSIONS must match the model's real output width and the Qdrant
# collection; the server verifies this at boot and refuses to start on mismatch.
#   gemini-embedding-001 → 3072
#   text-embedding-004   → 768
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072

# Gemini's free tier allows 100 embedded texts per minute per model. The value
# below leaves headroom for query embeddings served alongside an ingestion.
EMBEDDING_REQUESTS_PER_MINUTE=90
EMBEDDING_BATCH_SIZE=20

# ─── JWT ───────────────────────────────────────────────────────────────────
# Required in production and must be at least 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated exact origins (scheme + host, no trailing slash). Required in
# production; ignored in development, where all origins are allowed.
CORS_ORIGINS=https://codemind-web.onrender.com,https://code-mind-six.vercel.app

# ─── GitHub (optional — raises the API rate limit from 60 to 5000 req/hour) ─
GITHUB_TOKEN=

# ─── Limits ────────────────────────────────────────────────────────────────
MAX_REPO_FILES=500
